{
  "schemaVersion": 1,
  "id": "kineticclient",
  "version": "${version}",
  "name": "Kinetic Client",
  "description": "A Minecraft utility client with AutoClicker, KillAura and AimBot. Menu opens with right Shift.",
  "authors": [
    "axoisaxo"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.kineticclient.KineticClient"
    ]
  },
  "mixins": [
    "kineticclient.mixins.json"
  ],
  "jars": [
    {
      "file": "jna-5.14.0.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
